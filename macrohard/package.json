{
  "name": "macrohard-doors-os",
  "version": "2.11.54",
  "description": "Windows-stil Desktop OS im Browser \u2014 Neo-Brutalist, 22 Apps, PWA",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=4 tests/*.test.*",
    "test:browser": "node tests/app-smoke.browser.mjs",
    "lint": "eslint assets/app.js",
    "format": "prettier --write assets/app.js assets/site.css",
    "verify": "node --check assets/app.js && echo 'JS OK'"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "espree": "^10.4.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
